<?xml version="1.0" encoding="utf-8"?>
<!--
  Issue #127: 月表示ウィジェットのプレビュー（ウィジェット一覧に出す見本）。

  一覧のプレビューは RemoteViewsService に繋がらないため、本体
  （kansuke_month_widget）をそのまま出すとグリッドが空のまま描かれる。そこで
  見た目だけを写した静的なレイアウトを別に用意する（`previewLayout`、API 31 以上）。
  本体のレイアウト・スタイルを変えたら、こちらも合わせること。

  年月は出さない。プレビューは実データに繋がらないため、書くと必ず嘘になる。
  マスの中身は見本で、日付の並びは「1 日が日曜で 31 日ある月」を採っている。

  このファイルは手で書くには長いので、chore として生成した。マスの内容だけを
  変えたい場合は、下の並びをそのまま直してよい。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kansuke_widget_background"
